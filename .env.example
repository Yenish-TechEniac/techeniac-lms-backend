# Application runtime environment (development | test | production)
# Required: yes
NODE_ENV=development

# HTTP server port to listen on
# Required: yes
PORT=4000

# Minimum logging level threshold (e.g., debug, info, warn, error)
# Required: yes
LOG_LEVEL=info

# Pooled PostgreSQL connection string for runtime queries (Neon connection pooler or local PostgreSQL)
# TLS is configured by the connection string:
#   Neon / Cloud:     postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
#   Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/techeniac_lms?sslmode=disable
# Required: yes
DATABASE_URL=replace-me

# Direct unpooled PostgreSQL connection string for DDL schema migrations
# TLS is configured by the connection string:
#   Neon / Cloud:     postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
#   Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/techeniac_lms?sslmode=disable
# Required: yes
DIRECT_URL=replace-me

# PostgreSQL connection string for isolated integration tests
# TLS is configured by the connection string:
#   Neon / Cloud:     postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
#   Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/techeniac_lms?sslmode=disable
# Required: yes (for running tests)
TEST_DATABASE_URL=replace-me

# Comma-separated list of permitted CORS origins (e.g., http://localhost:3000)
# Required: yes
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxy hops to trust for client IP resolution
# Required: yes
TRUST_PROXY_HOPS=0

# Git commit SHA of the current release build
# Required: no (optional in local development, set in deployment environments)
COMMIT_SHA=

# JWT Secrets and Token Configuration
# Required: yes in production (minimum 32 characters)
JWT_ACCESS_SECRET=default_access_token_secret_minimum_32_characters_long_for_dev
JWT_REFRESH_SECRET=default_refresh_token_secret_minimum_32_characters_long_for_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

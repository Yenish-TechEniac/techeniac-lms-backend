{
  "name": "techeniac-lms-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:test-rules": "node scripts/test-lint-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/db/migration-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/db/migration-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/db/migration-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:unit": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:auth": "tsx scripts/test-auth-endpoints.ts",
    "test:courses": "tsx scripts/test-course-endpoints.ts",
    "test:progress": "tsx scripts/test-progress-endpoints.ts",
    "test:submissions": "tsx scripts/test-submission-endpoints.ts",
    "test:performance": "tsx scripts/test-performance-endpoints.ts",
    "test:audit": "tsx scripts/test-audit-endpoints.ts",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.3",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.1",
    "typeorm": "^0.3.20",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}

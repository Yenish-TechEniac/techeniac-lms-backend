{
  "name": "techeniac-lms-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:test-rules": "node scripts/test-lint-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/db/migration-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/core/db/migration-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/core/db/migration-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "^5.3.0",
    "http-status-codes": "^2.3.0",
    "pg": "^8.13.3",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
